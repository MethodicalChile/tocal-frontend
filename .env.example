# Ruta relativa pública a Django, a través del mismo dominio /api.
VITE_API_BASE=/api
# Vite DEV ONLY: servicio backend visible desde entorno de desarrollo
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
# Tiempo máximo de inactividad antes de cerrar la sesión automáticamente (en segundos; 300 = 5 minutos)
VITE_INACTIVITY_TIMEOUT_SECONDS=300
# Segundos antes del cierre en que aparece el contador regresivo de advertencia en pantalla
VITE_INACTIVITY_WARNING_SECONDS=10
# No agregues variables de Supabase secret/service role ni contraseñas aquí.
